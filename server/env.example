# Server Configuration
PORT=8000

# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/trip_together"

# JWT Configuration
ACCESS_TOKEN_SECRET="your-access-token-secret-change-this-in-production"
REFRESH_TOKEN_SECRET="your-refresh-token-secret-change-this-in-production"

# CORS Configuration
FRONTEND_URL="http://localhost:3000" 

# Object Storage (MinIO / S3-compatible)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password
MINIO_BUCKET=upload
MINIO_REGION=us-east-1
# If you route MinIO via a reverse proxy, set this to build public URLs
# MINIO_PUBLIC_URL="http://localhost:9000"